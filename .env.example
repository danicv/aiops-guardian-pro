# Copy to .env. Defaults run in deterministic demo mode with no API key.
APP_ENV=local
DEMO_MODE=true
DEMO_DATA_ENABLED=true
# Optional live LLM (OpenAI-compatible, e.g. local Ollama)
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional embeddings retrieval (empty = lexical fallback)
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
