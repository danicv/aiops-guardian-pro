# Copy to .env. Defaults run in deterministic demo mode with no API key.
APP_ENV=local
DEMO_MODE=true
DEMO_DATA_ENABLED=true
# Optional live LLM (OpenAI-compatible, e.g. local Ollama)
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional embeddings retrieval (empty = lexical fallback)
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Capstone defaults: no operational mutations, including approvals and notifications.
DECISION_SUPPORT_ONLY=true
# Expire persisted conversations after 30 days of inactivity; cleanup hourly and on access.
CONVERSATION_RETENTION_DAYS=30
CONVERSATION_CLEANUP_SECONDS=3600
